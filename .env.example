# Copy this to .env.local for local dev, or set as env vars in Portainer for prod.

# --- Database ---
# Local dev: relative file. Production: absolute path inside the container, mounted to NAS volume.
DATABASE_URL="file:./dev.db"

# --- Cloudflare Access ---
# Your Cloudflare team domain (find in Zero Trust dashboard → Settings → Custom Pages).
# Looks like: yourteam.cloudflareaccess.com (no https://, no trailing slash)
CF_ACCESS_TEAM_DOMAIN=""
# The Application Audience (AUD) tag from your Access application (Settings → Overview).
# Looks like a long hex string.
CF_ACCESS_AUD=""

# When true, skips CF Access JWT verification (local dev only — NEVER set in production).
DISABLE_AUTH="false"

# --- Anthropic / Claude (for pump-screen OCR) ---
ANTHROPIC_API_KEY=""

# --- App ---
# Used for any absolute URLs the app generates.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
